#!/usr/bin/env bash
#
# PELLETINO - build a multi-game arcade medal.
#
#   ./pelletino              what this build contains
#   ./pelletino pick         choose which games go in (when more fit than the flash holds)
#   ./pelletino build        artwork + partition table + firmware
#   ./pelletino flash [port] write it all to a connected medal
#
# Run ./pelletino help for the rest.
#
set -euo pipefail
cd "$(dirname "$0")"

IDF_IMAGE=espressif/idf:v5.3.4
VENV=.venv
BUILD=build_docker

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_off=$'\033[0m'
say()  { printf '%s==>%s %s\n' "$c_bold" "$c_off" "$*"; }
warn() { printf '%s!!%s  %s\n' "$c_red" "$c_off" "$*" >&2; }
ok()   { printf '%s ok%s %s\n' "$c_grn" "$c_off" "$*"; }

need_docker() {
    command -v docker >/dev/null || { warn "docker is not installed"; exit 1; }
    docker info >/dev/null 2>&1 || { warn "docker is installed but not running"; exit 1; }
}

ensure_venv() {
    if [ ! -x "$VENV/bin/python" ]; then
        say "creating $VENV (one time)"
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install --quiet --upgrade pip
        "$VENV/bin/pip" install --quiet Pillow
    fi
}

cmd_status()  { python3 tools/configure.py --check; }

cmd_install() {
    ensure_venv
    "$VENV/bin/python" tools/install.py "$@"
}

cmd_pick() {
    ensure_venv
    "$VENV/bin/python" tools/pick.py "$@"
}

cmd_art() {
    ensure_venv
    say "fetching logos and screenshots (from a third-party archive - see tools/fetch_art.py)"
    "$VENV/bin/python" tools/fetch_art.py "$@"
}

cmd_games() {
    printf '\n  %sApproved games%s - drop the matching zip in roms/ to include one\n\n' "$c_bold" "$c_off"
    python3 - <<'PY'
import tomllib, os
d = tomllib.load(open('games.toml','rb'))
for g in d['game']:
    rom = g['rom']
    have = os.path.exists(f'roms/{rom}.zip')
    mark = '\033[32m*\033[0m' if have else ' '
    print(f'   {mark} {rom:<11}{g.get("title",rom):<22}{g.get("project","") or ""}')
print('\n   * = ROM present in roms/\n')
PY
}

cmd_build() {
    need_docker; ensure_venv
    say "artwork (a game without any gets its title in text)"
    "$VENV/bin/python" tools/pack_art.py | tail -3
    # music/splash.mid is picked up at CMake configure time, so make sure configure
    # re-runs when it is added, removed or swapped
    touch components/chiptune/CMakeLists.txt main/CMakeLists.txt
    say "generating partition table"
    python3 tools/configure.py
    say "building firmware"
    mkdir -p build
    if ! docker run --rm -v "$PWD":/project -w /project "$IDF_IMAGE" \
        idf.py -B "$BUILD" -DIDF_TARGET=esp32c6 build > build/launcher.log 2>&1; then
        grep -E 'error|Error' build/launcher.log | head -12
        warn "the launcher did not build - the full log is build/launcher.log"
        exit 1
    fi
    ok "firmware at $BUILD/pelletino.bin ($(($(wc -c < "$BUILD/pelletino.bin") / 1024)) KB)"
    echo "   next: ./pelletino flash"
}

cmd_flash() {
    local port="${1:-}"
    [ -f "$BUILD/pelletino.bin" ] || { warn "no firmware - run ./pelletino build first"; exit 1; }
    tools/flash_all.sh ${port:+"$port"}
}

cmd_clean() { rm -rf "$BUILD" build/manifest.json; ok "cleaned"; }

cmd_help() {
    cat <<'EOF'

  PELLETINO - a multi-game arcade medal for the Waveshare ESP32-C6-LCD-1.69

    ./install.sh             everything: ROMs in roms/ to a flashed medal, in one step

    ./pelletino              what this build contains, and what it is missing
    ./pelletino games        the approved list, and which ROMs you have
    ./pelletino pick         choose which games fit this build (when they overflow)
    ./pelletino build        artwork + partition table + firmware
    ./pelletino flash [port] write everything to a connected medal
    ./pelletino clean        remove build output

  Getting started

    1. Put ROM zips in roms/ using their MAME names (./pelletino games lists them).
       We ship no ROMs; finding them is up to you.
    2. ./pelletino build
    3. ./pelletino flash

  A game appears in the menu only if its ROM is in roms/. Nothing else to edit -
  the partition table and the menu are both generated from what it finds.
  games.toml can force a game on or off if you need to override that.

EOF
}

case "${1:-status}" in
    status|'')  cmd_status ;;
    games|list) cmd_games ;;
    install)    shift; cmd_install "$@" ;;
    pick)       shift; cmd_pick "$@" ;;
    build)      cmd_build ;;
    flash)      shift; cmd_flash "$@" ;;
    art)        shift; cmd_art "$@" ;;
    clean)      cmd_clean ;;
    help|-h|--help) cmd_help ;;
    *) warn "unknown command: $1"; cmd_help; exit 1 ;;
esac
