# ESP32-C6 specific defaults for SHORYUKEN
CONFIG_IDF_TARGET="esp32c6"

# CPU frequency: everything here is short of CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Compiler optimizations - CRITICAL for emulation performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS tick rate (1ms ticks)
CONFIG_FREERTOS_HZ=1000

# Stack overflow detection
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# I2S audio support
CONFIG_SOC_I2S_SUPPORTED=y

# SPI DMA
CONFIG_SPI_MASTER_IN_IRAM=y

# The task watchdog is off, as in every game here: the main loop only blocks when the
# emulation is ahead of the clock, and on this machine it never is, so the idle task
# would go unfed and the watchdog would bite a program that is working as designed.
CONFIG_ESP_TASK_WDT_EN=n

# Log level (reduce for release)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
