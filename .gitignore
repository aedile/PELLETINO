# game source is vendored under games/ (see VENDORED.md for upstream mirrors)
roms/
*.zip
__pycache__/
.venv/
build_docker/
build/
sdkconfig
sdkconfig.old
*.dSYM/
lcd/preview/

# splash music is the composer's; supply your own (see music/README.md)
music/*.mid
music/*.midi

# marquee artwork is copyrighted (game logos); ship none - fetch or supply your own
marquees/*.png
marquees/_placeholder/
lcd/marquees.bin
lcd/marquees/

# --- vendored game build/rom artifacts (belt-and-suspenders) ---
games/**/build/
games/**/build_*/
games/**/managed_components/
games/**/sdkconfig
games/**/sdkconfig.old
games/**/sdkconfig.defaults.old
games/**/dependencies.lock
games/**/*.zip
games/**/media.bin
games/**/main/roms/*.h
games/**/host/harness
games/**/host/harness_*
games/**/host/*.dSYM/
games/**/*.o
games/**/*.ppm
.DS_Store

# gameplay/attract video is the publishers' copyright - never commit it
*.mp4
*.mjpeg
*.mov

# per-user build pick list (pelletino pick)
selection.txt

# generated by tools/configure.py on every build (reflects your ROM pick)
partitions.csv
.claude/
**/.claude/
